# Copy to .env for local runs (.env is gitignored and NOT bundled by lambda-web deploy).
AWS_LAMBDA_HTTP_ENDPOINT=127.0.0.1:3000
OTEL_SERVICE_NAME=lambda-web-poc
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://<environment-id>.live.dynatrace.com/api/v2/otlp
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
# Secret — do not commit. Format: "Api-Token dt0c01...."
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Api-Token REPLACE_ME
